# Copy to .env and fill in. NEVER commit .env. Placeholders only below.
# Process environment variables take precedence over .env.

# ---- Backend selection (explicit; an invalid value is an error, never a silent default) ----
# ORDER_BACKEND:   mock | shopify      (unset = mock)
# PAYMENT_BACKEND: mock | stripe       (unset = mock; stripe = TEST MODE only)
ORDER_BACKEND=mock
PAYMENT_BACKEND=mock

# ---- Shopify Admin API (only read when ORDER_BACKEND=shopify) ----
# Your dev store, exactly like your-store.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Supported Admin API version (default 2026-07 if unset)
SHOPIFY_API_VERSION=2026-07
# Auth option A (Dev Dashboard app, recommended for new apps): client credentials grant.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Auth option B: a static Admin API access token (existing legacy custom apps only).
# If set, it takes precedence over option A.
SHOPIFY_ACCESS_TOKEN=
# How ORD-1001 maps to the Shopify order name. Default "#" + number => "#1001".
SHOPIFY_ORDER_NAME_PREFIX=#
SHOPIFY_ORDER_NAME_SUFFIX=
SHOPIFY_TIMEOUT_SECONDS=10

# ---- Stripe (only read when PAYMENT_BACKEND=stripe). TEST-mode keys only: sk_test_... / rk_test_... ----
STRIPE_SECRET_KEY=
STRIPE_TIMEOUT_SECONDS=10

# ---- RAG embeddings and answer generation ----
# Chroma is stored locally under data/chroma_index and indexed from data/knowledge_base.
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_RETRIEVAL_MODE=hybrid
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_API is also accepted as a legacy alias.

# Optional LangChain / LangSmith tracing (set a project API key to enable remote traces).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=customer-support-rag
LANGCHAIN_API_KEY=
# Current LangSmith variable names are also accepted by LangChain.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=customer-support-rag
LANGSMITH_API_KEY=

# ---- Zendesk (not implemented yet) ----
TICKET_BACKEND=mock
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
